# Copy to .env and fill in as needed. 1router reads these via Config::from_env()
# (src/core/config.rs) — none are loaded from a .env file automatically unless
# your shell/process manager sources one.

# --- Core app config (src/core/config.rs) ---

# Required. Shared bearer secret admin/proxy callers must present.
ROUTER_SHARED_SECRET=
# Optional. If set, /admin/* requires this separate bearer secret while /v1/*
# continues to use ROUTER_SHARED_SECRET.
ROUTER_ADMIN_SECRET=

# Optional, defaults shown.
ROUTER_LISTEN_ADDR=0.0.0.0:8080
ROUTER_SQLITE_PATH=1router.db
# Path to a first-boot seed config file (providers/pools). Only applied when
# the DB is empty. See Task P4-2.
ROUTER_SEED_PATH=
ROUTER_MAX_BODY_BYTES=10485760
ROUTER_CONNECT_TIMEOUT=10
ROUTER_TTFB_TIMEOUT=60
ROUTER_IDLE_TIMEOUT=120
ROUTER_DRAIN_TIMEOUT=30
# Optional. Set to 1 to include x-1router-error raw upstream snippets in responses.
ROUTER_DEBUG_ERROR_HEADERS=0

# --- Codex OAuth adapter (src/providers/adapter/codex/*) ---

# Override the token endpoint (used by tests to point at a mock server).
# Leave unset in production — defaults to the real Codex/ChatGPT token URL.
CODEX_TOKEN_URL=

# --- Deferred real-provider e2e tests (tests/e2e_real_providers.rs, Task P4-4) ---
# Only needed to run: cargo test --test e2e_real_providers -- --ignored
# These hit real provider APIs, cost money, and can be rate-limited.

E2E_OPENAI_KEY=
E2E_OPENAI_BASE=
E2E_ANTHROPIC_KEY=
E2E_ANTHROPIC_BASE=
